{
  "name": "capshelf",
  "version": "0.10.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "//packageManager": "The one Bun version. Workflows read it with setup-bun's bun-version-file, then assert the version they actually got.",
  "packageManager": "bun@1.3.14",
  "bin": {
    "capshelf": "./dist/capshelf"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test --parallel=4",
    "e2e": "./scripts/e2e.sh",
    "e2e:run": "./scripts/e2e.sh --no-build",
    "coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "mkdir -p dist && bun build --compile --minify --target=bun ./src/cli.ts --outfile=./dist/capshelf",
    "smoke": "make smoke"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ignore": "^7.0.5",
    "smol-toml": "^1.6.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
